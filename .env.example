# Скопируй этот файл в .env и заполни своими значениями.
# .env НИКОГДА не коммитится в git (см. .gitignore).

BOT_TOKEN=123456:AA...твой_токен_от_BotFather
GROQ_API_KEY=...ключ_с_console.groq.com
STT_LANGUAGE=ru

# Необязательно: постоянный адрес Mini App вместо туннеля
# WEBAPP_URL=https://твой-домен

# Необязательно: порт локального сервера Mini App (по умолчанию 8080)
WEBAPP_PORT=8080
